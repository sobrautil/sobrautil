/* ==========================================================================
   Configurações Globais & Variáveis
   ========================================================================== */
   :root {
    --primary-color: #2e7d32;      /* Verde sustentabilidade */
    --primary-hover: #1b5e20;
    --secondary-color: #4caf50;
    --background-bg: #f4f7f6;
    --card-bg: #ffffff;
    --text-primary: #2c3e50;
    --text-secondary: #666666;
    --border-color: #e0e0e0;
    --shadow-soft: 0 4px 12px rgba(0, 0, 0, 0.05);
    --radius: 10px;
    --font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: var(--font-family);
    background-color: var(--background-bg);
    color: var(--text-primary);
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
}

main {
    max-width: 1200px;
    margin: 2rem auto;
    padding: 0 1.5rem;
    width: 100%;
    flex: 1;
}

/* ==========================================================================
   Cabeçalho & Navegação
   ========================================================================== */
header {
    background-color: var(--card-bg);
    border-bottom: 2px solid var(--border-color);
    padding: 1rem 2rem;
    box-shadow: var(--shadow-soft);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
}

header h1 {
    color: var(--primary-color);
    font-size: 1.8rem;
    font-weight: 700;
}

nav {
    display: flex;
    gap: 1rem;
    align-items: center;
}

nav a {
    text-decoration: none;
    color: var(--text-primary);
    font-weight: 600;
    transition: color 0.2s ease;
}

nav a:hover {
    color: var(--primary-color);
}

/* ==========================================================================
   Seções & Cartões
   ========================================================================== */
section {
    margin-bottom: 2.5rem;
}

section h2 {
    font-size: 1.5rem;
    color: var(--primary-color);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--secondary-color);
}

/* Grid para as seções com múltiplos artigos (Resumo, Lotes, Doadores, ONGs) */
section:nth-of-type(2),
section:nth-of-type(3),
section:nth-of-type(4),
section:nth-of-type(5) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
}

/* Ajuste do título da seção no Grid */
section:nth-of-type(2) h2,
section:nth-of-type(3) h2,
section:nth-of-type(4) h2,
section:nth-of-type(5) h2 {
    grid-column: 1 / -1;
}

article {
    background: var(--card-bg);
    border-radius: var(--radius);
    padding: 1.5rem;
    box-shadow: var(--shadow-soft);
    border: 1px solid var(--border-color);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

article:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
}

article h3 {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
}

article p {
    color: var(--text-secondary);
    font-size: 0.95rem;
}

/* Esconde as linhas separadoras horizontais para manter visual limpo de cards */
hr {
    display: none;
}

/* ==========================================================================
   Acesso Rápido (Links em formato de botões)
   ========================================================================== */
section:last-of-type p {
    margin: 0;
}

section:last-of-type a {
    display: block;
    background-color: var(--primary-color);
    color: white;
    text-align: center;
    padding: 0.8rem 1.2rem;
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 600;
    transition: background-color 0.2s ease;
}

section:last-of-type a:hover {
    background-color: var(--primary-hover);
}

/* ==========================================================================
   Rodapé
   ========================================================================== */
footer {
    background-color: var(--card-bg);
    border-top: 1px solid var(--border-color);
    text-align: center;
    padding: 1.5rem;
    margin-top: auto;
    color: var(--text-secondary);
    font-size: 0.9rem;
}

footer p + p {
    margin-top: 0.3rem;
}

/* ==========================================================================
   Responsividade
   ========================================================================== */
@media (max-width: 768px) {
    header {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
    }

    nav {
        flex-wrap: wrap;
        gap: 0.8rem;
    }
}