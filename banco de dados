CREATE DATABASE sobrautil;

USE sobrautil;


CREATE TABLE Usuario (

    idUsuario INT AUTO_INCREMENT PRIMARY KEY,

    email VARCHAR(100),

    senha VARCHAR(100),

    telefone VARCHAR(20),

    statusCadastro VARCHAR(20)

);


CREATE TABLE Doador (

    idDoador INT AUTO_INCREMENT PRIMARY KEY,

    idUsuario INT,

    cnpj VARCHAR(20),

    razaoSocial VARCHAR(100),

    regimeTributario VARCHAR(50),

    FOREIGN KEY (idUsuario) REFERENCES Usuario(idUsuario)

);


CREATE TABLE ONG (

    idONG INT AUTO_INCREMENT PRIMARY KEY,

    idUsuario INT,

    cnpj VARCHAR(20),

    nomeInstituicao VARCHAR(100),

    FOREIGN KEY (idUsuario) REFERENCES Usuario(idUsuario)

);


CREATE TABLE LoteAlimento (

    idLote INT AUTO_INCREMENT PRIMARY KEY,

    idDoador INT,

    descricao VARCHAR(200),

    quantidadeKg DECIMAL(10,2),

    dataValidade DATE,

    valorCustoTotal DECIMAL(10,2),

    status VARCHAR(20),

    FOREIGN KEY (idDoador) REFERENCES Doador(idDoador)

);


CREATE TABLE Doacao (

    idDoacao INT AUTO_INCREMENT PRIMARY KEY,

    idLote INT,

    idONG INT,

    dataReserva DATETIME,

    tokenQRCode VARCHAR(100),

    statusDoacao VARCHAR(20),

    FOREIGN KEY (idLote) REFERENCES LoteAlimento(idLote),

    FOREIGN KEY (idONG) REFERENCES ONG(idONG)

);


CREATE TABLE RelatorioFiscal (

    idRelatorio INT AUTO_INCREMENT PRIMARY KEY,

    idDoador INT,

    mesAnoRef VARCHAR(10),

    valorTotalCusto DECIMAL(10,2),

    valorIncentivoEst DECIMAL(10,2),

    FOREIGN KEY (idDoador) REFERENCES Doador(idDoador)

);


